-- Buy a shop item
local function buyAtPosition(pos, times)
	buying = true
	local char, hrp = getChar()
	if not char or not hrp then
		buying = false
		return
	end

	local shop
	repeat
		shop = workspace:FindFirstChild('Ignored')
			and workspace.Ignored:FindFirstChild('Shop')
		task.wait(0.2)
	until shop

	local closest, click, dist = nil, nil, math.huge
	for _, item in ipairs(shop:GetChildren()) do
		local part = item:FindFirstChildWhichIsA('BasePart')
		local cd = item:FindFirstChildOfClass('ClickDetector')
		if part and cd then
			local d = (part.Position - pos.Position).Magnitude
			if d < dist then
				closest, click, dist = part, cd, d
			end
		end
	end
	if not closest or not click then
		buying = false
		return
	end

	local original = hrp.CFrame
	for i = 1, times do
		pcall(function()
			local tool = char:FindFirstChildOfClass('Tool')
			if tool then
				tool.Parent = lp.Backpack
			end
		end)
		hrp.CFrame = closest.CFrame + Vector3.new(0, 3, 0)
		task.wait(0.15)
		pcall(fireclickdetector, click)
		task.wait(0.35)
	end
	hrp.CFrame = original
	buying = false
end

-- Equip/unequip helper
local function equipWeapon()
	local char, _, hum = getChar()
	local tool = char:FindFirstChild(weaponName)
		or lp.Backpack:FindFirstChild(weaponName)
	if tool and hum then
		tool.Parent = char
		pcall(function()
			hum:EquipTool(tool)
		end)
	end
	return tool
end

local function unequipWeapon()
	local char, _, hum = getChar()
	local tool = char:FindFirstChild(weaponName)
	if tool then
		tool.Parent = lp.Backpack
	end
end

-- Get ammo helper
local function getAmmo()
	local tool = lp.Character and lp.Character:FindFirstChild(weaponName)
		or lp.Backpack:FindFirstChild(weaponName)
	if tool and tool:FindFirstChild('Ammo') then
		return tool.Ammo.Value
	end
	return 0
end

-- Original reload method
local function reloadIfNeeded()
	if getAmmo() > 0 then
		return
	end
	task.spawn(function()
		local tool = equipWeapon()
		if not tool then
			return
		end
		local vim = game:GetService('VirtualInputManager')
		pcall(function()
			vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
			task.wait(0.1)
			vim:SendKeyEvent(false, Enum.KeyCode.R, false, game)
		end)
		task.wait(5)
		if getAmmo() == 0 then
			-- only buy ammo if LMG exists
			if
				lp.Backpack:FindFirstChild(weaponName)
				or (lp.Character and lp.Character:FindFirstChild(weaponName))
			then
				buyAtPosition(ammoPos, 1)
			end
		end
	end)
end

-- Blocking reload+buy while orbiting
local function reloadAndBuyBlocking()
	if getAmmo() > 0 then
		return true
	end
	local tool = equipWeapon()
	if not tool then
		buyAtPosition(lmgPos, 1)
		task.wait(0.6)
		tool = equipWeapon()
		if not tool then
			return false
		end
	end

	local vim = game:GetService('VirtualInputManager')
	pcall(function()
		vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
		task.wait(0.1)
		vim:SendKeyEvent(false, Enum.KeyCode.R, false, game)
	end)

	local t0 = tick()
	while tick() - t0 < 3 do
		task.wait(0.25)
		if getAmmo() > 0 then
			return true
		end
	end

	-- Only buy ammo if LMG exists
	if
		lp.Backpack:FindFirstChild(weaponName)
		or (lp.Character and lp.Character:FindFirstChild(weaponName))
	then
		buyAtPosition(ammoPos, 1)
		task.wait(0.6)
		equipWeapon()
	end

	return getAmmo() > 0
end

-- Safe auto-buy: LMG first, then ammo if needed
local function autoBuy()
	local char, _, _ = getChar()
	while
		not (
			lp.Backpack:FindFirstChild(weaponName)
			or char:FindFirstChild(weaponName)
		)
	do
		buyAtPosition(lmgPos, 1)
		task.wait(0.5)
		char = lp.Character or lp.CharacterAdded:Wait()
	end

	local tool = char:FindFirstChild(weaponName)
		or lp.Backpack:FindFirstChild(weaponName)
	if tool and tool:FindFirstChild('Ammo') and tool.Ammo.Value == 0 then
		buyAtPosition(ammoPos, 1)
	end
end

