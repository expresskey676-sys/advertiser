-- Orbit + attack
local function attackTarget(target)
	buying = true
	local char, hrp = getChar()
	local tool = equipWeapon()
	if not tool then
		buying = false
		return
	end
	currentTarget = target
	local tHum = target.Character:FindFirstChildOfClass('Humanoid')
	local tHRP = target.Character:FindFirstChild('HumanoidRootPart')
	if not tHum or not tHRP then
		buying = false
		return
	end
	chat(adMessages[math.random(1, #adMessages)])
	local startTime = tick()
	local shootDuration = 2
	local angle = 0
	while tick() - startTime < 10 do
		if not tHum or not tHRP or not hrp then
			break
		end
		if getAmmo() <= 0 then
			currentTarget = nil
			local ok = reloadAndBuyBlocking()
			if not ok then
				break
			end
			tool = equipWeapon()
			if not tool then
				break
			end
			currentTarget = target
		end
		angle = angle + orbitSpeed * 0.125
		local pos = tHRP.Position
		pcall(function()
			hrp.CFrame = CFrame.new(
				Vector3.new(
					pos.X + math.cos(angle) * orbitRadius,
					pos.Y,
					pos.Z + math.sin(angle) * orbitRadius
				),
				pos
			)
		end)
		if tick() - startTime <= shootDuration and tHum.Health > 10 then
			pcall(function()
				tool:Activate()
			end)
		elseif tick() - startTime > shootDuration and tool.Parent == char then
			unequipWeapon()
		end
		task.wait(0.01)
	end
	currentTarget = nil
	buying = false
end

-- Target selection
local targeted = {}
local function resetTargetedIfNeeded()
	local pool = {}
	for _, p in pairs(Players:GetPlayers()) do
		if
			p ~= lp
			and p.Character
			and p.Character:FindFirstChild('HumanoidRootPart')
		then
			table.insert(pool, p)
		end
	end
	local all = true
	for _, p in ipairs(pool) do
		if not table.find(targeted, p.Name) then
			all = false
			break
		end
	end
	if all then
		targeted = {}
	end
end
local function pickNextTarget()
	resetTargetedIfNeeded()
	local best, dist = nil, math.huge
	local _, hrp = getChar()
	for _, p in pairs(Players:GetPlayers()) do
		if
			p ~= lp
			and p.Character
			and p.Character:FindFirstChild('HumanoidRootPart')
		then
			if not table.find(targeted, p.Name) then
				local d = (p.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
				if d < dist then
					dist, best = d, p
				end
			end
		end
	end
	return best
end

